# The one mandatory paid dependency. A public RPC returned 1,835 failures out of 2,286 requests.
BASE_RPC_URL=https://base-mainnet.example/v2/YOUR_KEY
FORK_BLOCK=50614000

# RAG vectoriel (lot N). Le service `db` du docker-compose est pgvector/pgvector:pg16.
DATABASE_URL=postgres://tare:tare@localhost:5432/tare
# Si 5432 est deja pris sur la machine : demarrer avec TARE_DB_PORT=55432 docker compose up -d db
# et pointer le moteur dessus. TARE_PG_DSN gagne sur DATABASE_URL.
# TARE_DB_PORT=55432
# TARE_PG_DSN=postgresql://tare:tare@127.0.0.1:55432/tare
OLLAMA_URL=http://127.0.0.1:11434
TARE_EMBED_MODEL=granite-embedding:278m
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- l'abonnement
# Le contrat lu par GET /compte avant d'ouvrir cles et telechargements. Deploye par
# contracts/script/DeployerAbonnement.s.sol ; sans ces deux variables, le compte repond
# « abonnement non verifie, donc pas actif » — un refus motive, pas une panne.
# TARE_ABONNEMENT_CONTRAT=0x…
# TARE_ABONNEMENT_RPC=https://sepolia.base.org
# TARE_ABONNEMENT_CHAIN_ID=84532

# ------------------------------------------------------------- la substitution
# Le noeud interroge par POST /alternative pour la cotation vivante et les deux lectures
# Permit2. A defaut, TARE_RPC_URL. Ces appels sont FACTURES : la route ne les fait que si une
# porte mesuree moins chere existe, ce qui arrive sur 15 des 125 072 lignes du corpus.
# TARE_SUBSTITUTION_RPC=https://mainnet.base.org

# ------------------------------------------------------------------ le MCP
# Une cle d'API de portee « mcp », pour que les appels d'outils entrent dans l'historique du
# compte. FACULTATIVE : sans elle le serveur MCP n'emet aucune requete.
# TARE_CLE_API=tare_m_…
