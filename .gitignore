__pycache__/
*.pyc
.env
.venv/
node_modules/

# EXCEPTION. Les sources verifiees recuperees sur Sourcify vivent parfois sous un chemin
# `node_modules/` — c'est ainsi que le projet d'origine avait range ses dependances, et
# Sourcify restitue l'arborescence telle quelle. Ce ne sont PAS des dependances installees :
# c'est la preuve que l'analyse cite. Le filtre global en excluait 85 fichiers .sol, et
# 20 des 543 citations publiees pointaient donc vers des lignes qu'un lecteur ne pouvait
# pas ouvrir. Une citation qu'on ne peut pas suivre n'est pas une citation.
!docs/hooks-source/**/node_modules/
!docs/hooks-source/**/node_modules/**
dist/
packages/guard/extension/inject.js

# --- artefacts DERIVES, reconstruits par scripts/regenerate.sh ---------------
# Ils pesaient 296 Mo a eux trois et l'un depassait la limite de 100 Mo de GitHub.
# Aucun n'est une source : chacun se recalcule depuis docs/dataset/measurements.jsonl,
# qui reste versionne parce que c'est LA preuve — tout le projet promet que chaque
# nombre s'y rejoue.
#   engine/tare/graph/cli.py build     -> graph.json        (188 Mo)
#   apps/web/scripts/build-dataset.mjs -> src/data/dataset.json (87 Mo)
#   packages/guard/scripts/build-table.mjs -> data/table.json   (21 Mo)
engine/tare/graph/data/graph.json
apps/web/src/data/dataset.json
packages/guard/data/table.json

# Clones et binaires des applications Ledger compilees pour Speculos.
# Le .elf se reconstruit en une commande (scripts/ledger/build-app.sh) ; le committer
# ajouterait 300 ko de binaire opaque au depot pour aucune verifiabilite en plus.
.cache/
infra/speculos/apps/*.elf

# Le trousseau : il contient la cle privee du MEMBRE. Revocable, mais secrete.
# `ring seal` le recree en une commande, contre l'appareil.
var/
