# apps/api — surcharge locale. Les valeurs par defaut viennent du .env de la racine.
# Ne commite jamais un .env rempli.

PORT=8787

# Le fork anvil que le moteur interroge (docker compose up -d).
TARE_RPC_URL=http://127.0.0.1:8545
FORK_BLOCK=50614000

# Peage x402. X402_ENABLED=0 desactive le peage (utile en local).
X402_ENABLED=1
HEDERA_NETWORK=hedera:testnet
BLOCKY402_URL=https://api.testnet.blocky402.com
HEDERA_FEE_PAYER=0.0.7162784
# Le compte qui ENCAISSE. A defaut, HEDERA_FEE_PAYER est utilise — ce qui n'est
# correct que pour une demo : mets ici le compte Hedera de TARE.
HEDERA_PAY_TO=0.0.7162784

# Facturation : l'unite est LA MESURE, pas la requete.
TARE_UNIT_PRICE_USD=0.001
TARE_MAX_UNITS=10

# Fixtures (tests) — laisse vide en production.
# TARE_JSONL_PATH=
# TARE_V1_PATH=
# TARE_POOLS_PATH=
