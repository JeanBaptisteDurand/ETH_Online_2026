    /**
     * Calls for the BidWall to be closed, as this requires callback from the {PoolManager}.
     */
    function closeBidWall(
        PoolKey memory _key
    ) public {
        // Ensure that the call is made by the BidWall which validates logic
        if (msg.sender != address(bidWall)) {
            revert CallerIsNotBidWall();
        }

        // Ensure that the PoolKey that is being closed is valid and recognised on the protocol,
        // otherwise we could processing issues and false positives in upcoming steps. We need to
        // ensure that the PoolKey is recognised (by checking the hooks address is not zero) and
        // that the PoolId matches when encoded.
        PoolKey memory storedKey = _poolKeys[address(_key.memecoin(pairedToken(_key.toId())))];
        if (storedKey.hooks == IHooks(address(0)) || PoolId.unwrap(storedKey.toId()) != PoolId.unwrap(_key.toId())) {
            revert UnknownPool(_key.toId());
        }

        // Action our BidWall closure via the {PoolManager} unlock
        _closeBidWall(_key);
    }

    /**
     * Unwinds the BidWall position for a pool via a {PoolManager} unlock.
     *
     * @dev The caller is responsible for validating the `PoolKey` before this is reached.
     *
     * @param _poolKey The PoolKey to close the BidWall of
     */
    function _closeBidWall(
        PoolKey memory _poolKey
    ) internal override {
        poolManager.unlock(abi.encode(UnlockCallbackType.CLOSE_BIDWALL, abi.encode(_poolKey)));
    }

    /**
     * Handles the unlock callback for the {PoolManager} interactions.
     *
     * @param _data The encoded data for the unlock callback
     *
     * @return bytes The data to be returned from the unlock callback
     */
    function _unlockCallback(
        bytes calldata _data
    ) internal override returns (bytes memory) {
        // Decode the data to determine the action and payload
        (UnlockCallbackType _action, bytes memory _payload) = abi.decode(_data, (UnlockCallbackType, bytes));

        // Check if we are closing the BidWall
        if (_action == UnlockCallbackType.CLOSE_BIDWALL) {
            bidWall.closeBidWall(abi.decode(_payload, (PoolKey)));
            return '';
        }
        // Check if we are seeding the liquidity and premine
        else if (_action == UnlockCallbackType.FLAUNCH_LIQUIDITY) {
            return _seedLiquidityAndPremine(_payload);
        }

        // Return empty data if we haven't matched any of the actions
        return '';
    }

    /**
     * Seeds a freshly flaunched pool with its initial single-sided liquidity and, if requested,
     * fills a premine for the creator. Runs inside the {PoolManager} unlock context.
     *
     * The full token supply is held by this contract following the flaunch. We seed the supply as
     * a single-sided memecoin sell position and, if a premine was requested, swap against that
     * position to deliver the premined tokens to the creator. Any flETH we wrapped but did not end
     * up spending on the premine is unwrapped back into ETH so {flaunch} can refund the caller.
     *
     * @param _payload ABI-encoded `(address memecoin, address creator, address payer, uint premineAmount, uint remainingValue, uint maxPremineCost)`
     *
     * @return amountSpent_ ABI-encoded amount of ETH consumed by the premine swap (zero for an
     * ERC20-paired premine, which is funded in the paired token rather than ETH)
     */
    function _seedLiquidityAndPremine(
        bytes memory _payload
    ) internal returns (bytes memory amountSpent_) {
        // Decode the payload to provide the required information
        (address memecoin, address creator, address payer, uint premineAmount, uint remainingValue, uint maxPremineCost) =
            abi.decode(_payload, (address, address, address, uint, uint, uint));

        // Resolve the pool key and determine if the native token is the zero token
        PoolKey memory _poolKey = _poolKeys[memecoin];
        PoolId poolId = _poolKey.toId();
        address paired = pairedToken(poolId);

        // Both the seeding and the premine run in the linked {FlaunchLibrary}: their bytecode is
        // sizeable and lives at the library's own address rather than inside this hook, which sits
        // against the EIP-170 limit. The library is reached by `delegatecall`, so it creates the
        // position and settles from this contract's balances exactly as if it were inlined. The
        // paired token's shape comes from this pool's frozen launch-time snapshot (never the live
        // registry), so a later registry change cannot alter how an existing pool premines.
        amountSpent_ = abi.encode(
            FlaunchLibrary.seedLiquidityAndPremine(
                FlaunchLibrary.SeedParams({
                    poolManager: poolManager,
                    poolKey: _poolKey,
                    initialTick: initialPoolTick[poolId],
                    nativeIsZero: paired == Currency.unwrap(_poolKey.currency0),
                    tokenType: _pairedTokenConfig[poolId].tokenType,
                    paired: paired,
                    memecoin: memecoin,
                    creator: creator,
                    payer: payer,
                    premineAmount: premineAmount,
                    remainingValue: remainingValue,
                    maxPremineCost: maxPremineCost
                })
            )
        );
    }

    /**
     * Whether a pool's paired token is raw native ETH (`address(0)`), read from the pool's
     * launch-time snapshot. A native-ETH pool settles its paired side directly in ETH, so premine
     * funds from `msg.value` without any wrap and the BidWall / escrow move value rather than an ERC20.
     *
     * @param _poolId The pool whose paired token is being checked
     *
     * @return Whether the pool's paired token is raw native ETH
     */
    function _isNativeEth(
        PoolId _poolId
    ) internal view returns (bool) {
        return _pairedTokenConfig[_poolId].tokenType == IPairedTokenRegistry.PairedTokenType.NativeEth;
    }

    /**
     * Capture the fees from our swap. This could either be from an internal swap (`beforeSwap`)
     * or from the actual Uniswap swap (`afterSwap`).
     *
     * @dev This is only used due to too many variables in the `beforeSwap` function
     *
     * @param _key The {PoolKey} that the swap was made against
     * @param _params The swap parameters called in the swap
     * @param _sender The sender of the swap call
     * @param _delta The balance change from the swap
     * @param _hookData Additional bytes data passed in the swap
     *
     * @return swapFee_ The fee taken from the swap
     */
    function _captureAndDepositFees(
        PoolKey calldata _key,
        SwapParams memory _params,
        address _sender,
        int128 _delta,
        bytes calldata _hookData
    ) internal returns (uint swapFee_) {
        // Determine the swap fee currency based on swap parameters
        Currency swapFeeCurrency = _params.amountSpecified < 0 == _params.zeroForOne ? _key.currency1 : _key.currency0;

        // Capture our swap fees amount
        swapFee_ = _captureSwapFees({
            _poolManager: poolManager,
            _key: _key,
            _params: _params,
            _feeCalculator: feeCalculator,
            _swapFeeCurrency: swapFeeCurrency,
            _swapAmount: uint128(_delta < 0 ? -_delta : _delta),
            _feeExemption: feeExemptions.feeExemption(_sender)
        });

        // If we have no swap fees, then we have nothing to process
        if (swapFee_ == 0) {
            return swapFee_;
        }

        // Check if we have a referrer set and send them the currency directly
        uint referrerFee =
            _distributeReferrerFees({_key: _key, _swapFeeCurrency: swapFeeCurrency, _swapFee: swapFee_, _hookData: _hookData});

        // Deposit the remaining fees against our pool to be either distributed to
        // others, or placed into the Internal Swap Pool to be converted into the paired
        // token. We don't reduce the amount by referrer fees as we still need to claim
        // this from the PoolManager. `amount0` is always the paired-token side.
        bool feeIsPairedSide = Currency.unwrap(swapFeeCurrency) == pairedToken(_key.toId());
        uint depositAmount = swapFee_ - referrerFee;
        internalSwapPool.depositFees(_key, feeIsPairedSide ? depositAmount : 0, feeIsPairedSide ? 0 : depositAmount);
    }

    /**
     * We want to be able to distribute fees across our {FeeDistribution} recipients
     * when we reach a set threshold. This will only ever distribute the ETH equivalent
     * token, as the non-ETH token will be converted via the {InternalSwapPool} hook logic.
     *
     * @dev There referrer has already received their share, so they do not need to be
     * taken into account at this point.
     *
     * @param _poolKey The PoolKey reference that will have fees distributed
     * @param _swapTick The pre-swap tick, snapshotted by {_afterSwap} before any external call
     * could have overwritten the shared `_beforeSwapTick` slot
     */
    function _distributeFees(
        PoolKey memory _poolKey,
        int24 _swapTick
    ) internal {
        PoolId poolId = _poolKey.toId();

        // Get the amount of the paired token available to distribute
        uint distributeAmount = internalSwapPool.poolFees(_poolKey).amount0;

        // Ensure that the collection has sufficient fees available. The threshold is read from the
        // pool's launch-time snapshot (decimals-aware per paired token), falling back to the
        // protocol default for flETH.
        if (distributeAmount < _minDistributeThreshold(poolId)) {
            return;
        }

        // Reduce our available fees for the pool
        internalSwapPool.resetNativeFees(poolId);

        // Find the distribution amount across our different users. The amount that treasury
        // receives will be determined by variables throughout the distribution flow, such as
        // the BidWall being disabled, etc.
        (uint bidWallFee, uint creatorFee, uint protocolFee) = feeSplit(poolId, distributeAmount);
        uint treasuryFee;

        // Load our paired token; the memecoin is derived from it at each use rather than held in
        // a local, because this function sits on the stack-depth limit and `_swapTick` needs the
        // room. `memecoin()` is a pure {PoolKey} accessor, so re-deriving it costs no storage read.
        address paired = pairedToken(poolId);

        // [F-9] The Flaunch NFT is a bearer instrument: whoever holds it right now is the
        // creator that fees should route to. Read `memecoin.creator()` live at each decision
        // point rather than caching once across external calls. Defends against any future
        // call-path that could change ownership between branches (e.g. an ERC721 receiver
        // hook on a buyer's transferFrom callback flipping the NFT mid-distribution).

        if (creatorFee != 0) {
            address creatorNow = _memecoinCreator(address(_poolKey.memecoin(paired)));
            // Ensure that the pool creator has not burned their ownership and send them the fees
            if (creatorNow != address(0)) {
                _allocateFees(poolId, creatorNow, creatorFee);
            }
            // If the pool creator has burned their ownership, then we instead send fees directly
            // to the BidWall.
            else {
                bidWallFee += creatorFee;
                creatorFee = 0;
            }
        }

        if (bidWallFee != 0) {
            // Check if we have an active BidWall for the pool. If we don't have an active BidWall, then
            // we will need to instead allocate this to the protocol.
            if (bidWall.isBidWallEnabled(poolId)) {
                // Otherwise, we can deposit directly into the BidWall as we have permission to modify
                // liquidity outside of the window. A native-ETH pool pushes the fee as value so the
                // BidWall custodies it; an ERC20 pool leaves the fee in this hook (the BidWall pulls
                // it via the allowance set in {_ensureBidWallApproval}).
                // [L-2] Re-assert the BidWall's allowance before it pulls. `ensureBidWallApproval`
                // otherwise runs only at LAUNCH, so an allowance-decrementing paired token drains
                // the grant over the pool's life and the reposition eventually reverts inside
                // `afterSwap` -- permanently, by H-2's rollback mechanics, with no owner recovery.
                // This mirrors the `< amount` self-heal `_allocateFees` already performs. Called
                // unconditionally: the library no-ops for raw native ETH, and for any token
                // honouring a `type(uint).max` allowance the sentinel check never fires.
                FlaunchLibrary.ensureBidWallApproval(address(bidWall), paired);

                uint bidWallValue = _isNativeEth(poolId) ? bidWallFee : 0;
                bidWall.deposit{value: bidWallValue}(_poolKey, bidWallFee, _swapTick, paired == Currency.unwrap(_poolKey.currency0));
            } else {
                // If we cannot import into BidWall, then treasury will be allocated the fees
                treasuryFee += bidWallFee;
                bidWallFee = 0;
            }
        }

        if (treasuryFee != 0) {
            // Re-read the live creator to settle the treasury branch: a burn that happens
            // between the creator-fee allocation and here must route through to the protocol.
            if (_memecoinCreator(address(_poolKey.memecoin(paired))) != address(0)) {
                _allocateFees(poolId, _poolKey.memecoin(paired).treasury(), treasuryFee);
            } else {
                // If we cannot allocate to treasury, then protocol receives the fees
                protocolFee += treasuryFee;
                treasuryFee = 0;
            }
        }

        // Finally we allocate our protocol fees
        if (protocolFee != 0) {
            _allocateFees(poolId, protocolFeeRecipient, protocolFee);
        }

        emit PoolFeesDistributed(poolId, distributeAmount, creatorFee, bidWallFee, treasuryFee, protocolFee);
    }

    /**
     * Using the `tstore` values that we have generated along the way, we emit an event that shows
     * the breakdown of fees earned at each swap point.
     *
     * @dev Delegated to the linked {FlaunchLibrary}. The eighteen `tload`s and the thirteen-field
     * {PoolSwap} emit compile to roughly a kilobyte of bytecode that this hook — which sits against
     * the EIP-170 limit — cannot afford to carry. `delegatecall` keeps the executing address as
     * this contract, so the transient slots read and cleared are this hook's own and the logs are
     * emitted under this hook's address, byte-for-byte as before.
     *
     * @param _poolId The PoolId that is being emitted
     * @param _sender The router of the swap
     */
    function _emitSwapUpdate(
        PoolId _poolId,
        address _sender
    ) internal {
        FlaunchLibrary.emitSwapUpdate(_poolId, _sender);
    }

    /**
     * Emits an event that provides pool state updates and passes the data to subscribers.
     *
     * @dev Delegated to the linked {FlaunchLibrary} so the two {PoolManager} state reads and the
     * six-field event emit are deployed at the library's address rather than in this hook, which
     * sits against the EIP-170 limit. Kept behind this wrapper (rather than delegating from each of
     * the five call sites) so only one delegated call frame is paid for.
     *
     * @param _poolId The PoolId that has been updated
     * @param _key The selector being sent to notification subscribers
     * @param _data The data being sent to notification subscribers
     */
    function _emitPoolStateUpdate(
        PoolId _poolId,
        bytes4 _key,
        bytes memory _data
    ) internal {
        FlaunchLibrary.emitPoolStateUpdate(poolManager, address(notifier), _poolId, _key, _data);
    }

    /**
     * Settles tokens against the PoolManager based on the BalanceDelta passed.
     *
     * @dev This is required to be separated due to Stack Too Deep errors
     *
     * @param _poolKey The pool key to settle against
     * @param _delta The BalanceDelta showing token amounts to settle
     */
    function _settleDelta(
        PoolKey memory _poolKey,
        BalanceDelta _delta
    ) internal {
        if (_delta.amount0() < 0) {
            _poolKey.currency0.settle(poolManager, address(this), uint(-int(_delta.amount0())), false);
        } else if (_delta.amount0() > 0) {
            poolManager.take(_poolKey.currency0, address(this), uint(int(_delta.amount0())));
        }

        if (_delta.amount1() < 0) {
            _poolKey.currency1.settle(poolManager, address(this), uint(-int(_delta.amount1())), false);
        } else if (_delta.amount1() > 0) {
            poolManager.take(_poolKey.currency1, address(this), uint(int(_delta.amount1())));
        }
    }

    /**
     * We need to be able to set the (un)specified token to amount0 / amount1 for the expected
     * event emit format.
     *
     * @param _params The `SwapParams` used to capture the delta
     * @param _key_amount0 The tstore key for the token0 amount
     * @param _key_amount1 The tstore key for the token1 amount
     * @param _delta The `BeforeSwapDelta` that is being captured
     */
    function _captureDelta(
        SwapParams memory _params,
        bytes32 _key_amount0,
        bytes32 _key_amount1,
        BeforeSwapDelta _delta
    ) internal {
        (int token0, int token1) = _params.amountSpecified < 0 == _params.zeroForOne
            ? (-_delta.getSpecifiedDelta(), -_delta.getUnspecifiedDelta())
            : (-_delta.getUnspecifiedDelta(), -_delta.getSpecifiedDelta());

        // Store our amounts
        assembly {
            tstore(_key_amount0, token0)
            tstore(_key_amount1, token1)
        }
    }

    /**
     * Maps our swap fee to the expected event emit format.
     *
     * @param _params The `SwapParams` used to capture the delta
     * @param _key_fee0 The tstore key for the token0 fee amount
     * @param _key_fee1 The tstore key for the token1 fee amount
     * @param _delta The `uint` that is being captured for the fee
     */
    function _captureDeltaSwapFee(
        SwapParams memory _params,
        bytes32 _key_fee0,
        bytes32 _key_fee1,
        uint _delta
    ) internal {
        // The delta provided needs to be made negative
        int delta = -int(_delta);

        if (_params.amountSpecified < 0 == _params.zeroForOne) {
            assembly {
                tstore(_key_fee0, 0)
                tstore(_key_fee1, delta)
            }
        } else {
            assembly {
                tstore(_key_fee0, delta)
                tstore(_key_fee1, 0)
            }
        }
    }

    /**
     * Helper function to allow for tstore-d variables to be called individually. This saves us
     * defining an additional variable before our `tload` calls inside the function.
     *
     * @param _key The `tstore` key to load
     *
     * @return value_ The `int` value in the tstore
     */
    function _tload(
        bytes32 _key
    ) internal view returns (int value_) {
        assembly {
            value_ := tload(_key)
        }
    }
}
