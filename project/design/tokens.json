{
  "version": 1,
  "color": {
    "bg": "#08090a",
    "fg": "#e8eaed",
    "accent": "#eb6628",
    "accent2": "#3376f6",
    "muted": "#a2a9b0",
    "surface": "#17191c"
  },
  "font": {
    "display": {
      "family": "JetBrains Mono Variable",
      "fallback": "ui-monospace, SFMono-Regular, Menlo, monospace",
      "weights": [400, 500, 700],
      "source": "self",
      "files": [
        { "src": "@fontsource-variable/jetbrains-mono", "weight": 400, "style": "normal", "format": "woff2" }
      ]
    },
    "body": {
      "family": "Instrument Sans Variable",
      "fallback": "ui-sans-serif, system-ui, sans-serif",
      "weights": [400, 500, 600, 700],
      "source": "self",
      "files": [
        { "src": "@fontsource-variable/instrument-sans", "weight": 400, "style": "normal", "format": "woff2" }
      ]
    },
    "mono": {
      "family": "JetBrains Mono Variable",
      "fallback": "ui-monospace, SFMono-Regular, Menlo, monospace",
      "weights": [400, 500, 700],
      "source": "self",
      "files": [
        { "src": "@fontsource-variable/jetbrains-mono", "weight": 400, "style": "normal", "format": "woff2" }
      ]
    }
  },
  "radius": "0px",
  "space": { "unit": "8px" },
  "motion": {
    "preset": "calm",
    "variance": 6,
    "motion": 3,
    "density": 8,
    "smoothScroll": false
  },
  "background": null,
  "extra": {
    "familles": {
      "collecte": { "sombre": "#3376f6", "clair": "#1b4fc4" },
      "analyse": { "sombre": "#f6d746", "clair": "#9a7b00" },
      "action": { "sombre": "#eb6628", "clair": "#c2410c" }
    },
    "rampe": {
      "role": "sequentielle, encode le prelevement en points de base, jamais autre chose",
      "sombre": ["#390963", "#6a176e", "#9b2964", "#ca404a", "#eb6628", "#fb9b06", "#f6d746"],
      "clair": ["#fff8bb", "#ffe590", "#feca66", "#fea446", "#fd7435", "#f23924", "#d41020"]
    },
    "lignes": { "line": "#24272b", "lineStrong": "#383c42", "baseline": "#6b7178" },
    "texte": {
      "ink3": "#6b7178",
      "regle": "ink3 ne porte plus de texte sous 18,66 px : 4,04:1 sur le fond echoue en AA. Le texte secondaire passe a muted #a2a9b0, 8,4:1."
    },
    "typo": {
      "display": "clamp(3.5rem, 8vw, 8.5rem) mono 500, interlettrage 0",
      "titleLg": "28px sans 600 -0.02em",
      "title": "20px sans 600 -0.02em",
      "body": "16px sans 400, 68 caracteres au plus",
      "data": "13px mono 400, tabular-nums",
      "dataSm": "11px mono 400 0.02em",
      "ratio": "10,5:1 entre display et data"
    },
    "piste": {
      "largeur": "1px",
      "geometrie": "orthogonale uniquement, aucun arrondi, aucune courbe",
      "flux": "trait plein — outil vers outil",
      "alimentation": "tirets 4/4 — jeu de donnees vers outil",
      "terminaison": "segment perpendiculaire de 6px, jamais une fleche pleine"
    },
    "grille": {
      "colonnes": 12,
      "gouttiere": "24px",
      "largeurMax": "1440px",
      "gouttiereLaterale": { "desktop": "24px", "mobile": "16px" },
      "tableaux": "display:grid; gap:1px sur fond line — les filets naissent de la grille, aucune bordure declaree"
    },
    "cibles": { "noeudCarte": "44px", "minimum": "24px" }
  }
}
